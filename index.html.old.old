<!DOCTYPE html>
<html lang="it">

<head>
    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="referrer" content="strict-origin-when-cross-origin">

    <meta name="description"
        content="MCT Studios - Community fondata da Carmine Russo e co-fondata da Francesco Imperato.">

    <title>MCT Studios</title>

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="assets/logo.png">

    <!-- CSS -->
    <link rel="stylesheet" href="style.css">
</head>


<body>

    <!-- HEADER -->

    <header class="navbar">

        <a href="#home" class="brand">

            <img src="assets/logo.png" alt="Logo MCT Studios">

            <span>MCT Studios</span>

        </a>


        <nav>

            <a href="#home">Home</a>

            <a href="#fondatori">Fondatori</a>

            <a href="#video">Video</a>

            <a href="#social">Social</a>

        </nav>

    </header>



    <!-- HERO -->

    <main id="home">

        <section class="hero">

            <div class="hero-glow hero-glow-left"></div>

            <div class="hero-glow hero-glow-right"></div>


            <!-- BANNER -->

            <div class="banner-container">

                <img
                    src="assets/banner.png"
                    alt="MCT Studios Banner"
                    class="banner-image">

            </div>


            <!-- LOGO GRANDE -->

            <img
                src="assets/logo.png"
                alt="Logo MCT Studios"
                class="hero-logo">


            <!-- TITOLO -->

            <h1>MCT Studios</h1>


            <p class="hero-description">

                Una community fondata da Carmine Russo e co-fondata da
                Francesco Imperato, due creator uniti dalla passione per
                YouTube, i contenuti e la loro community.

            </p>


            <!-- BOTTONI -->

            <div class="hero-buttons">

                <a
                    href="https://www.youtube.com/channel/UCnWK3DxNpi8BKR3pwV5o1Pg"
                    target="_blank"
                    class="btn btn-primary">

                    ▶ YouTube MCT Studios

                </a>


                <a
                    href="https://www.instagram.com/mct__studios/"
                    target="_blank"
                    class="btn btn-secondary">

                    ◎ Instagram

                </a>

            </div>

        </section>



        <!-- FONDATORI -->

        <section id="fondatori" class="section">

            <div class="section-title">

                <span class="section-line"></span>

                <h2>I Fondatori</h2>

                <span class="section-line"></span>

            </div>


            <p class="section-subtitle">

                MCT Studios nasce dall'unione di due creator e dalla voglia
                di costruire una community unica.

            </p>


            <div class="founders-grid">


                <!-- CARMINE -->

                <article class="founder-card">

                    <div class="founder-avatar purple-avatar">

                        CR

                    </div>


                    <h3>Carmine Russo</h3>

                    <p class="founder-role">

                        Fondatore & Owner

                    </p>


                    <p class="founder-description">

                        Creator e fondatore di MCT Studios.

                    </p>


                    <a
                        href="https://www.youtube.com/channel/UCvkrdVTL7Uft-QPkUD_A4Cw"
                        target="_blank"
                        class="creator-link">

                        Visita il canale →

                    </a>

                </article>



                <!-- FRANCESCO -->

                <article class="founder-card">

                    <div class="founder-avatar blue-avatar">

                        FI

                    </div>


                    <h3>Francesco Imperato</h3>

                    <p class="founder-role">

                        Co-Fondatore & Owner

                    </p>


                    <p class="founder-description">

                        Creator e co-fondatore di MCT Studios.

                    </p>


                    <a
                        href="https://www.youtube.com/@therealfrancescoimp"
                        target="_blank"
                        class="creator-link">

                        Visita il canale →

                    </a>

                </article>


            </div>

        </section>



        <!-- ULTIMI VIDEO -->

        <section id="video" class="section video-section">


            <div class="section-title">

                <span class="section-line"></span>

                <h2>Ultimi Video</h2>

                <span class="section-line"></span>

            </div>


            <p class="section-subtitle">

                Guarda gli ultimi contenuti pubblicati dai creator di MCT Studios.

            </p>



            <div class="videos-grid">


                <!-- FRANCESCO IMPERATO -->

                <article class="video-card">

                    <div class="creator-header">


                        <div class="creator-avatar creator-blue">

                            FI

                        </div>


                        <div class="creator-info">

                            <h3>Francesco Imperato</h3>

                            <p>

                                @therealfrancescoimp

                            </p>

                        </div>


                        <a
                            href="https://www.youtube.com/@therealfrancescoimp"
                            target="_blank"
                            class="youtube-channel-button">

                            ▶ Canale

                        </a>

                    </div>



                    <!-- VIDEO -->

                    <div class="video-wrapper">

                        <!--
                        Questo embed usa il feed degli upload del canale.
                        Se YouTube non dovesse riconoscere l'handle come username,
                        lo sistemiamo inserendo direttamente il Channel ID.
                        -->

                        <iframe
                            src="https://www.youtube.com/embed/videoseries?list=UUUCKlhrDoLeX4YFphBM-Y4TCA"
                            title="Ultimo video di Francesco Imperato"
                            referrerpolicy="strict-origin-when-cross-origin"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                            allowfullscreen>

                        </iframe>

                    </div>


                </article>



                <!-- MRCRTV -->

                <article class="video-card">

                    <div class="creator-header">


                        <div class="creator-avatar creator-purple">

                            MR

                        </div>


                        <div class="creator-info">

                            <h3>MRCRTV_</h3>

                            <p>

                                Creator & Founder

                            </p>

                        </div>


                        <a
                            href="https://www.youtube.com/channel/UCvkrdVTL7Uft-QPkUD_A4Cw"
                            target="_blank"
                            class="youtube-channel-button">

                            ▶ Canale

                        </a>

                    </div>



                    <!-- VIDEO -->

                    <div class="video-wrapper">

                        <!--
                        Playlist automatica degli upload del canale MRCRTV.
                        -->

                        <iframe
                            src="https://www.youtube.com/embed/videoseries?list=UUvkrdVTL7Uft-QPkUD_A4Cw"
                            title="Ultimi video di MRCRTV"
                            referrerpolicy="strict-origin-when-cross-origin"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                            allowfullscreen>

                        </iframe>

                    </div>


                </article>


            </div>

        </section>



        <!-- SOCIAL -->

        <section id="social" class="section social-section">


            <div class="section-title">

                <span class="section-line"></span>

                <h2>Seguici</h2>

                <span class="section-line"></span>

            </div>


            <p class="section-subtitle">

                Entra nella community e resta aggiornato su tutti i contenuti
                di MCT Studios.

            </p>



            <div class="social-grid">


                <!-- INSTAGRAM -->

                <a
                    href="https://www.instagram.com/mct__studios/"
                    target="_blank"
                    class="social-card instagram-card">

                    <div class="social-icon">

                        ◎

                    </div>


                    <div>

                        <h3>Instagram</h3>

                        <p>@mct__studios</p>

                    </div>


                    <span class="social-arrow">

                        →

                    </span>

                </a>



                <!-- YOUTUBE -->

                <a
                    href="https://www.youtube.com/channel/UCnWK3DxNpi8BKR3pwV5o1Pg"
                    target="_blank"
                    class="social-card youtube-card">

                    <div class="social-icon">

                        ▶

                    </div>


                    <div>

                        <h3>YouTube</h3>

                        <p>MCT Studios</p>

                    </div>


                    <span class="social-arrow">

                        →

                    </span>

                </a>


            </div>


        </section>


    </main>



    <!-- FOOTER -->

    <footer>

        <img
            src="assets/logo.png"
            alt="MCT Studios">


        <p>

            © 2026 MCT Studios. Tutti i diritti riservati.

        </p>


        <p class="footer-small">

            Francesco Imperato × Carmine Russo

        </p>

    </footer>


</body>

</html>
